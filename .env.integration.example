# =============================================================================
# Black-box E2E / integration stack — copy to `.env.integration` (gitignored).
# =============================================================================
# Prerequisites: integration Postgres (host 5434 — avoids local Postgres on 5433):
#   npm run docker:integration:db:up
# Apply Prisma migrations to integration DBs (auth / course / analytics):
#   npm run prisma:migrate:deploy:integration
# Or start Postgres + migrate in one step:
#   npm run docker:integration:db:prepare
#
# Run the full black-box stack (build required first: npm run build):
#   npm run integration:stack:up      # start auth/course/analytics + gateway, gate on health
#   npm run integration:stack:down    # stop stack recorded by up / Jest
#   npm run integration:stack:health  # poll GET /internal/downstream-health once
#   npm run integration:db:reset      # truncate app tables (optional; tests use unique tenants)
#   npm run integration:down          # stack:down + docker DB down
#   npm run integration:up            # db:prepare + build + stack:up
#
# Test isolation: uniqueTestIdentity() in test/integration/test-identity.ts
# (unique tenant name + email per run). Optional full wipe: integration:db:reset.
# Run Jest black-box smoke / E2E (stack must be healthy, or Jest will start it):
#   npm run test:integration
# Skip auto-start (fail if gateway not up): INTEGRATION_SKIP_STACK_START=1 npm run test:integration
#
# Prisma reads `DATABASE_URL` in each microservice process only. This file keeps
# canonical URLs in INTEGRATION_DATABASE_URL_* for scripts/Compose; for manual
# `nest start`, export DATABASE_URL per app (see “Prisma” at bottom).
#
# Never use production secrets. Replace JWT / INTERNAL values in CI.

# --- Runtime ---
NODE_ENV=test

# --- Supertest / HTTP client ---
GATEWAY_BASE_URL=http://127.0.0.1:3000

# --- Shared secrets (gateway JWT validation must match auth-org token signing) ---
JWT_SECRET=integration-jwt-secret-min-32-chars-do-not-use-in-prod
INTERNAL_SERVICE_SECRET=integration-internal-service-secret-not-for-prod

# --- api-gateway ---
PORT=3000
AUTH_ORG_TCP_HOST=127.0.0.1
AUTH_ORG_TCP_PORT=3001
COURSE_TCP_HOST=127.0.0.1
COURSE_TCP_PORT=3002
ANALYTICS_TCP_HOST=127.0.0.1
ANALYTICS_TCP_PORT=3003

# Optional gateway tuning
# GATEWAY_READINESS_TIMEOUT_MS=5000
# GATEWAY_CORS_ORIGINS=http://127.0.0.1:3000

# --- All microservices: TCP bind address (listen) ---
TCP_HOST=0.0.0.0

# --- auth-org-service ---
AUTH_ORG_TCP_PORT=3001
AUTH_ORG_HTTP_PORT=3011
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
INVITE_BASE_URL=http://127.0.0.1:3000
INVITE_EMAIL_FROM=no-reply@integration.local
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Billing (integration test fixtures — not real Stripe; signing uses STRIPE_WEBHOOK_SECRET)
STRIPE_SECRET_KEY=sk_test_integration_not_real
STRIPE_WEBHOOK_SECRET=whsec_integration_test_secret
STRIPE_FREE_INCLUDED_LEARNER_SEATS=3
STRIPE_PRICE_PRO=price_integration_pro
STRIPE_PRICE_ENTERPRISE=price_integration_enterprise
BILLING_CHECKOUT_RETURN_BASE_URL=http://127.0.0.1:3000
BILLING_SEAT_GRACE_DAYS=0

# --- course-service ---
COURSE_TCP_PORT=3002

# --- analytics-webhook-service ---
ANALYTICS_TCP_PORT=3003

# --- Optional Redis (main docker-compose uses it; safe default if unused locally) ---
REDIS_URL=redis://127.0.0.1:6379

# =============================================================================
# Postgres — integration instance (lms_it / lms_it @ 127.0.0.1:5434)
# =============================================================================
INTEGRATION_DATABASE_URL_AUTH_ORG=postgresql://lms_it:lms_it@127.0.0.1:5434/auth_db?schema=public
INTEGRATION_DATABASE_URL_COURSE=postgresql://lms_it:lms_it@127.0.0.1:5434/course_db?schema=public
INTEGRATION_DATABASE_URL_ANALYTICS=postgresql://lms_it:lms_it@127.0.0.1:5434/analytics_db?schema=public

# Prisma: set exactly one DATABASE_URL on each service process, e.g.:
#   auth-org-service:    export DATABASE_URL="$INTEGRATION_DATABASE_URL_AUTH_ORG"
#   course-service:        export DATABASE_URL="$INTEGRATION_DATABASE_URL_COURSE"
#   analytics-webhook:     export DATABASE_URL="$INTEGRATION_DATABASE_URL_ANALYTICS"
# (After sourcing this file in POSIX shell; on Windows set env per terminal / script.)

# --- If dev stack already uses 3000–3003, switch gateway + TCP ports together ---
# PORT=3100
# GATEWAY_BASE_URL=http://127.0.0.1:3100
# AUTH_ORG_TCP_PORT=3101
# COURSE_TCP_PORT=3102
# ANALYTICS_TCP_PORT=3103
