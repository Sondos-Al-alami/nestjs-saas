generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Placeholder for event / webhook outbox rows (expand as you add analytics).
model EventBuffer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  payload   Json
}
