generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id          String       @id @default(uuid())
  tenantId    String
  title       String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([tenantId])
}

model Lesson {
  id        String   @id @default(uuid())
  tenantId  String
  courseId  String
  title     String
  body      String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([courseId])
  @@index([tenantId, courseId])
}

/// Learner assigned to a course (`userId` = Auth service User.id, same tenant).
model Enrollment {
  id               String    @id @default(uuid())
  tenantId         String
  courseId         String
  userId           String
  enrolledAt       DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  /// Last activity in the course (open lesson, progress bump) — for analytics / seat signals.
  lastAccessedAt   DateTime?
  completedAt      DateTime?
  progressPercent  Int       @default(0)
  lessonsCompleted Int       @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, courseId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([courseId])
}
