NODE_ENV=development

# Shared transport + gateway
PORT=3000
TCP_HOST=127.0.0.1
AUTH_ORG_TCP_PORT=3001
AUTH_ORG_HTTP_PORT=3011
COURSE_TCP_PORT=3002
ANALYTICS_TCP_PORT=3003
AUTH_ORG_TCP_HOST=127.0.0.1
COURSE_TCP_HOST=127.0.0.1
ANALYTICS_TCP_HOST=127.0.0.1

# Auth + security
JWT_SECRET=replace-with-strong-secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_DAYS=30
INTERNAL_SERVICE_SECRET=replace-with-strong-secret

# Gateway hardening
GATEWAY_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
GATEWAY_TRUST_PROXY=false
GATEWAY_REQUEST_TIMEOUT_MS=30000
GATEWAY_READINESS_TIMEOUT_MS=2500
GATEWAY_JSON_LIMIT=256kb
GATEWAY_URLENCODED_LIMIT=256kb
GATEWAY_RATE_LIMIT_IP_TTL_MS=60000
GATEWAY_RATE_LIMIT_IP_LIMIT=120
GATEWAY_RATE_LIMIT_TENANT_TTL_MS=60000
GATEWAY_RATE_LIMIT_TENANT_LIMIT=600

# Alert thresholds
ALERT_5XX_RATE_THRESHOLD=0.05
ALERT_BILLING_WEBHOOK_FAILURE_RATE_THRESHOLD=0.02
ALERT_ANALYTICS_DLQ_OPEN_THRESHOLD=25
ALERT_ANALYTICS_DLQ_OLDEST_MINUTES_THRESHOLD=30

# Billing + Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_FREE_INCLUDED_LEARNER_SEATS=3
STRIPE_PRICE_PRO=price_replace_me_pro
STRIPE_PRO_INCLUDED_LEARNER_SEATS=10
STRIPE_PRICE_ENTERPRISE=price_replace_me_enterprise
STRIPE_ENTERPRISE_INCLUDED_LEARNER_SEATS=100
BILLING_CHECKOUT_RETURN_BASE_URL=http://localhost:3000
BILLING_SEAT_GRACE_DAYS=0

# Invites + SMTP
INVITE_BASE_URL=http://localhost:3000
INVITE_EMAIL_FROM=no-reply@lms.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Analytics webhook worker tuning
ANALYTICS_WEBHOOK_CIRCUIT_FAILURE_THRESHOLD=5
ANALYTICS_WEBHOOK_CIRCUIT_OPEN_MS=180000

# Optional infra vars
REDIS_URL=redis://localhost:6379
DOCKER_POSTGRES_USER=lms
DOCKER_POSTGRES_PASSWORD=lms
DOCKER_POSTGRES_DB=auth_db
DOCKER_AUTH_DB_NAME=auth_db
DOCKER_COURSE_DB_NAME=course_db
DOCKER_ANALYTICS_DB_NAME=analytics_db

# Per-service Prisma DATABASE_URL:
# - apps/auth-org-service/prisma/.env
# - apps/course-service/prisma/.env
# - apps/analytics-webhook-service/prisma/.env
# Use one DATABASE_URL per service env file, for example:
# DATABASE_URL=postgresql://lms:lms@localhost:5432/auth_db?schema=public
