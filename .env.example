# Copy each app's prisma/.env.example to apps/<app>/prisma/.env for Prisma CLI (migrate/generate).
# Runtime: each microservice uses DATABASE_URL pointing at its database.

# Auth & Org — apps/auth-org-service/prisma/.env
# DATABASE_URL="postgresql://lms:lms@localhost:5432/auth_db?schema=public"

# Course — apps/course-service/prisma/.env
# DATABASE_URL="postgresql://lms:lms@localhost:5432/course_db?schema=public"

# Analytics — apps/analytics-webhook-service/prisma/.env
# DATABASE_URL="postgresql://lms:lms@localhost:5432/analytics_db?schema=public"

# Event buffering (Redis)
# REDIS_URL="redis://localhost:6379"

# API gateway — JWT verification (required in production)
# JWT_SECRET="openssl rand -base64 32"
# Access JWT TTL (seconds); refresh tokens are opaque rows in auth_db (see Auth & Org).
# JWT_ACCESS_TTL_SEC=900
# JWT_REFRESH_TTL_DAYS=30

# Future gateway→service verification (optional)
# INTERNAL_SERVICE_SECRET=

# REST API
PORT=3000
TCP_HOST=127.0.0.1

# TCP microservice ports (API gateway connects as client to these)
AUTH_ORG_TCP_PORT=3001
# Auth & Org HTTP (Stripe webhooks only): POST /webhooks/stripe
AUTH_ORG_HTTP_PORT=3011
COURSE_TCP_PORT=3002
ANALYTICS_TCP_PORT=3003

# --- Stripe (Phase 4) — auth-org-service HTTP ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or Dashboard webhook endpoint
# Map Dashboard Price ids to LMS tier + bundled seats; optional per-learner recurring line.
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRO_INCLUDED_LEARNER_SEATS=10
# STRIPE_PRICE_ENTERPRISE=price_...
# STRIPE_ENTERPRISE_INCLUDED_LEARNER_SEATS=100
# Checkout / subscriptions must set `metadata.tenantId` on Session, Customer, or Subscription.
# BILLING_CHECKOUT_RETURN_BASE_URL=http://localhost:3000
# Internal checkout endpoint (auth-org HTTP): POST /billing/checkout
# Requires `x-internal-auth: $INTERNAL_SERVICE_SECRET` and admin role in body.
# Seat enforcement grace window (days) when over entitled seats before blocking.
# BILLING_SEAT_GRACE_DAYS=0

# Optional: per-service hostnames (Docker Compose uses service names; local dev can omit)
# AUTH_ORG_TCP_HOST=auth-org-service
# COURSE_TCP_HOST=course-service
# ANALYTICS_TCP_HOST=analytics-webhook-service

# --- Docker Compose local stack (override defaults) ---
# DOCKER_POSTGRES_USER=lms
# DOCKER_POSTGRES_PASSWORD=lms
# DOCKER_POSTGRES_DB=auth_db
# DOCKER_AUTH_DB_NAME=auth_db
# DOCKER_COURSE_DB_NAME=course_db
# DOCKER_ANALYTICS_DB_NAME=analytics_db
# For containers, ALWAYS override this outside local development:
# JWT_SECRET=replace-with-strong-secret
